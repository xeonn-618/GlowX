{
  "manifestVersion": 5,
  "id": "com.custom.photoshop.glowx",
  "name": "GlowX",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "glowx.panel",
      "label": {
        "default": "GlowX"
      },
      "minimumSize": { "width": 260, "height": 400 },
      "maximumSize": { "width": 800, "height": 1400 },
      "preferredDockedSize": { "width": 300, "height": 640 },
      "preferredFloatingSize": { "width": 320, "height": 640 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "domains": "all",
      "enableMessageBridge": "localAndRemote"
    }
  }
}
